{
  "name": "@relay/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Relay AI Agent Safety Layer",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "relay",
    "ai",
    "agent",
    "safety",
    "sdk"
  ],
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
